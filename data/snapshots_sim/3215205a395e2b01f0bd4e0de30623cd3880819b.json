\"all\">\n  <div id=\"back\">\n      <div id=\"header\">\n              <div class=\"logoheader\">\n                <!--div id=\"logoheadingbig\"><p style=\"color:#aaaaaa;\">Happening at IITK<br /><a href=\"http://techkriti.org/\" target=\"_blank\"><img src=\"/dosa/images/header_img/index.jpg\" /></a><br />06 to 09 March</p></div-->                \n          <h1 id=\"logo\">\n\n                    <a href=\"http://www.iitk.ac.in/dosa/\"><img src=\"/dosa/images/logo/DOSA.png\" alt=\"\" /></a>\n                    <span class=\"header1\">\n                    </span></h1>\n        </div><!-- end logoheader -->\n                 <div id=\"main-menu\"><div class=\"icemegamenu\"><ul id=\"icemegamenu\"><li id=\"iceMenu_794\" class=\"iceMenuLiLevel_1\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">News &amp; Events</span></a></li><li id=\"iceMenu_795\" class=\"iceMenuLiLevel_1\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Rules &amp; Notices</span></a></li><li id=\"iceMenu_796\" class=\"iceMenuLiLevel_1\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Students' Body</span></a></li><li id=\"iceMenu_797\" class=\"iceMenuLiLevel_1 parent\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Hall Management</span></a><ul class=\"icesubMenu sub_level_1\" style=\"width:280px\"><li><div style=\"float:left;width:280px\" class=\"iceCols\"><ul><li id=\"iceMenu_807\" class=\"iceMenuLiLevel_2\"><a href=\"http://students.iitk.ac.in/ss/home/cosha-2/\" target=\"_blank\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">COSHA</span></a></li><li id=\"iceMenu_808\" class=\"iceMenuLiLevel_2\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Hall of Residence</span></a></li><li id=\"iceMenu_809\" class=\"iceMenuLiLevel_2\"><a href=\"http://www.iitk.ac.in/dosa/wardens-of-all-halls-of-residences\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Counsel of Wardens</span></a></li></ul></div></li></ul></li><li id=\"iceMenu_798\" class=\"iceMenuLiLevel_1\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Antiragging</span></a></li><li id=\"iceMenu_799\" class=\"iceMenuLiLevel_1\"><a href=\"#\" class=\" iceMenuTitle\"><span class=\"icemega_title icemega_nosubtitle\">Our Team</span></a></li></ul></div>  \r\n<script type=\"text/javascript\">\r\n    window.addEvent('domready', function() {    \r\n\t\tif(document.getElementById('icemegamenu')!= null)\r\n\t\tvar myMenu = new MenuMatic({id:'icemegamenu',\r\n\t\t\tsubMenusContainerId: 'subMenusContainer',\r\n\t\t\teffect:'slide &amp; fade',\r\n\t\t\tduration:600,\r\n\t\t\tphysics:Fx.Transitions.Pow.easeOut,\r\n\t\t\thideDelay:1000,\r\n\t\t\topacity:100                                            \r\n\t\t});\r\n    });\r\n</script>\r\n</div>\n\n          <!--ul class=\"skiplinks\">\n            <li><a href=\"#main\" class=\"u2\">Skip to content</a></li>\n            <li><a href=\"#nav\" class=\"u2\">Jump to main navigation and login</a></li>\n                      </ul>\n          <h2 class=\"unseen\">Nav view search</h2>\n          <h3 class=\"unseen\">Navigation</h3>\n          \n          <!--div id=\"line\">\n          <div id=\"fontsize\"></div>\n          <h3 class=\"unseen\">Search</h3>\n          \n          </div> <!-- end line -->     \n    <div id=\"header-image\">\n      \n          </div>\n     <div id =\"hoverlogo\"></div> \n          </div><!-- end header -->\n        <div id=\"contentarea\">\n          <div id=\"breadcrumbs\">\n                    \n              \n<div class=\"breadcrumbs\">\n<span class=\"showHere\">You are here: </span><a href=\"/dosa/\" class=\"pathway\">Home</a> <img src=\"/dosa/templates/iitk/images/system/arrow.png\" alt=\"\"  /> <span>scholarships</span></div>\n\n\n          </div>\n          \n           <div id=\"mail\">\n                   \n             <a href=\"http://webmail.iitk.ac.in/\" target=\"_blank\">Webmail</a> | <a href=\"http://library.iitk.ac.in/\" target=\"_blank\">Library</a> | <a href=\"http://www.iitk.ac.in/\" target=\"_blank\">IITK Home</a> | <a href=\"http://www.iitk.ac.in/dosaold\" target=\"_blank\">Old Website</a>\n\n          </div>\n\n          \n          <div id=\"wrapper2\" class=\"shownocolumns\">\n\n            <div id=\"main\">\n\n              \n<div id=\"system-message-container\">\n</div>\n              \r\n<div class=\"item-page\">\n\n\n\n\n\n\n\n\n\n<table width=\"958px\" border=\"0\" cellspacing=\"2\">\r\n<tbody>\r\n<tr>\r\n<td valign=\"top\" width=\"4\"> </td>\r\n<td colspan=\"5\" valign=\"top\">\r\n<table width=\"958\" border=\"0\" cellspacing=\"5\">\r\n<tbody>\r\n<tr>\r\n<td class=\"leadingpf5\">\r\n<div class=\"tabletext\">\r\n<h3 class=\"head1\">SCHOLARSHIPS</h3>\r\n</div>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\" width=\"4\" height=\"154\"> </td>\r\n<td valign=\"top\" width=\"3\"> </td>\r\n<td valign=\"top\" width=\"4\"> </td>\r\n<td valign=\"top\" width=\"718\">\r\n<div class=\"tabletext\">\r\n<p><strong>1. How many scholarships are run by IIT Kanpur?</strong></p>\r\n<p><strong>Answer:</strong> The following scholarships run by IIT Kanpur:</p>\r\n<p>a) Merit-cum-Means</p>\r\n<p>b) Free Basic Mess</p>\r\n<p>c) INSPIRE scholarships</p>\r\n<p>d) Donor scholarships</p>\r\n<p> </p>\r\n<p><strong>2. What are the eligibility criteria for applying in above scholarships?</strong></p>\r\n<p><strong>Answer:</strong> For the eligibility criterion and other details, please refer the following link: <a href=\"/dosa/../sspc/\" target=\"_blank\">https://www.iitk.ac.in/sspc/</a></p>\r\n<p> </p>\r\n<p><strong>3. How can I apply for the eligible scholarship(s)?</strong></p>\r\n<p><strong>Answer:</strong> A notification is sent to all students with the scholarship forms and eligibility criterion. The filled forms are to be submitted to the SSPC Office, through e-mails (\n <script type='text/javascript'>\n <!--\n var prefix = '&#109;a' + 'i&#108;' + '&#116;o';\n var path = 'hr' + 'ef' + '=';\n var addy22093 = 'sspc' + '&#64;';\n addy22093 = addy22093 + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n var addy_text22093 = 'sspc' + '&#64;' + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n document.write('<a ' + path + '\\'' + prefix + ':' + addy22093 + '\\'>');\n document.write(addy_text22093);\n document.write('<\\/a>');\n //-->\\n </script><script type='text/javascript'>\n <!--\n document.write('<span style=\\'display: none;\\'>');\n //-->\n </script>This email address is being protected from spambots. You need JavaScript enabled to view it.\n <script type='text/javascript'>\n <!--\n document.write('</');\n document.write('span>');\n //-->\n </script>) or by hand at FB 272 E, SSPC Office, c/o DoSA Office, IIT Kanpur).</p>\r\n<p> </p>\r\n<p><strong>4. What is the process for signature on External Scholarships (KVPY, NTSE, FITJEE, Inspire, Samsung etc.)?</strong></p>\r\n<p><strong>Answer:</strong> Related forms filled up and duly signed by the applicant &amp; their parents wherever applicable are to be submitted to the SSPC office either in hardcopy or scanned manner (\n <script type='text/javascript'>\n <!--\n var prefix = '&#109;a' + 'i&#108;' + '&#116;o';\n var path = 'hr' + 'ef' + '=';\n var addy87418 = 'sspc' + '&#64;';\n addy87418 = addy87418 + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n var addy_text87418 = 'sspc' + '&#64;' + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n document.write('<a ' + path + '\\'' + prefix + ':' + addy87418 + '\\'>');\n document.write(addy_text87418);\n document.write('<\\/a>');\n //-->\\n </script><script type='text/javascript'>\n <!--\n document.write('<span style=\\'display: none;\\'>');\n //-->\n </script>This email address is being protected from spambots. You need JavaScript enabled to view it.\n <script type='text/javascript'>\n <!--\n document.write('</');\n document.write('span>');\n //-->\n </script>). Fee receipt of the 1<sup>st</sup> semester of the current academic year and grade sheets till the 2<sup>nd</sup> semester of pervious academic year are to be attached with the form.</p>\r\n<p> </p>\r\n<p><strong>5. I am first year student of an academic year. When should I apply for the scholarships?</strong></p>\r\n<p><strong>Answer:</strong> First announcement mail is sent in August. Second announcement is sent in January for MCM/FBM/INSPIRE.</p>\r\n<p> </p>\r\n<p><strong>6. Are the Scholarships semester- wise?</strong></p>\r\n<p><strong>Answer:</strong> No, all the scholarships are yearly.</p>\r\n<p> </p>\r\n<p><strong>7. If I have availed the scholarship in my first year do I need to apply for every year?</strong></p>\r\n<p><strong>Answer: </strong>Yes, you have to apply for every academic year, separately.</p>\r\n<p> </p>\r\n<p><strong>8. For what kind of scholarships, I can get the Bonafide certificate from SSPC?</strong></p>\r\n<p><strong>Answer: </strong>Yes, you can get bonafide certificate only related to scholarship from SSPC.</p>\r\n<p> </p>\r\n<p><strong>9. I am PG (MTech/MSR/PhD) student, where I can get information for Assistantship/Stipend?</strong></p>\r\n<p><strong>Answer: </strong>You contact to DOAA Office for the above information.</p>\r\n<p> </p>\r\n<p><strong>10. What kind of no objection certificates related to scholarships are issued by the SSPC Office?</strong></p>\r\n<p><strong>Answer: </strong>Only scholarships related NOC is issued by SSPC.</p>\r\n<p> </p>\r\n<p><strong>11. Whom should I contact for query related to scholarships?</strong></p>\r\n<p><strong>Answer: </strong>Please call us at 0512-259-6187 or mail \n <script type='text/javascript'>\n <!--\n var prefix = '&#109;a' + 'i&#108;' + '&#116;o';\n var path = 'hr' + 'ef' + '=';\n var addy86886 = 'sspc' + '&#64;';\n addy86886 = addy86886 + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n var addy_text86886 = 'sspc' + '&#64;' + '&#105;&#105;tk' + '&#46;' + '&#97;c' + '&#46;' + '&#105;n';\n document.write('<a ' + path + '\\'' + prefix + ':' + addy86886 + '\\'>');\n document.write(addy_text86886);\n document.write('<\\/a>');\n //-->\\n </script><script type='text/javascript'>\n <!--\n document.write('<span style=\\'display: none;\\'>');\n //-->\n </script>This email address is being protected from spambots. You need JavaScript enabled to view it.\n <script type='text/javascript'>\n <!--\n document.write('</');\n document.write('span>');\n //-->\n </script></p>\r\n</div>\r\n</td>\r\n<td valign=\"top\" width=\"6\"> </td>\r\n<td style=\"background-color: #f9f9e2;\" valign=\"top\" width=\"211\">\r\n<div class=\"tabletext\" style=\"background-color: #fdfdef;\"><img class=\"right-border\" src=\"/dosa/images/faculty-images/fac-right-column-top-border.png\" border=\"0\" /></div>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\n\t\n</div>\n\n                            \n                            \n            \n            </div><!-- end main -->\n\n          </div><!-- end wrapper -->\n\n        \n      \n          <div class=\"wrap\"></div>\n\n        </div> <!-- end contentarea -->\n\n      </div><!-- back -->\n\n    </div><!-- all -->\n\n    <div id=\"footer-outer\">\n\n          <div id=\"footer-inner\">\n\n        <div id=\"bottom\">\n                    <div class=\"box box1\"> </div>\n                                 <div class=\"box box2\"> </div>\n                              <div class=\"box box3\"> </div>\n                                        <div class=\"box box4\"> </div>\n                  </div>\n      </div>\n    \n      <div id=\"footer-sub\">\n\n              <div id=\"footer\">\n      \n          \n<ul class=\"menu\">\n<li class=\"item-269\"><a href=\"https://oa.iitk.ac.in/\" >Office Automation </a></li><li class=\"item-270\"><a href=\"#\" >Community Radio</a></li><li class=\"item-271\"><a href=\"#\" >Contact Us</a></li></ul>\n\n          \n              </div><!-- end footer -->\n      \n      </div>\n\n    </div>\n    \n  </body>\n</html>\n"}