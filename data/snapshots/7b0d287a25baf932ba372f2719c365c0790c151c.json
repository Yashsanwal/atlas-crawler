olor: #555;\r\n        }\r\n\r\n        .card {\r\n            background: #fff;\r\n            border-radius: 20px;\r\n            padding: 40px;\r\n            margin-top: 30px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            flex-wrap: wrap;\r\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);\r\n        }\r\n\r\n        .card-left {\r\n            flex: 1 1 50%;\r\n            text-align: left;\r\n            padding: 50px;\r\n        }\r\n\r\n        .logo {\r\n            width: 100px;\r\n            margin-bottom: 20px;\r\n            top: auto;\r\n        }\r\n\r\n        .card-left h2 {\r\n            font-size: 35px;\r\n            font-weight: 400;\r\n            color: #111;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n            .card-left h2 strong {\r\n                font-weight: bold;\r\n                color: #000;\r\n            }\r\n\r\n        .register-btn {\r\n            padding: 10px 20px;\r\n            background-color: #5b7d5c;\r\n            color: white;\r\n            border: none;\r\n            border-radius: 6px;\r\n            font-size: 14px;\r\n            cursor: pointer;\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .account-text {\r\n            font-size: 13px;\r\n            margin-top: 10px;\r\n        }\r\n\r\n        .create-account {\r\n            color: #000;\r\n            font-weight: bold;\r\n            text-decoration: none;\r\n        }\r\n\r\n        .card-right {\r\n            flex: 1 1 40%;\r\n            text-align: right;\r\n            position: relative;\r\n        }\r\n\r\n        .login-top {\r\n            position: absolute;\r\n            top: 0;\r\n            right: 0;\r\n            margin: 20px;\r\n            font-size: 14px;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .login-btn {\r\n            padding: 6px 14px;\r\n            background-color: #5b7d5c;\r\n            color: white;\r\n            border: none;\r\n            border-radius: 6px;\r\n            font-size: 14px;\r\n            cursor: pointer;\r\n        }\r\n\r\n        .graduate-img {\r\n            width: 100%;\r\n            max-width: 600px;\r\n            margin-top: 50px;\r\n        }\r\n        .video-guide-section {\r\n            margin-top: 25px;\r\n        }\r\n\r\n        .video-container {\r\n            display: flex;\r\n            justify-content: flex-start;\r\n        }\r\n\r\n        .video-wrapper {\r\n            position: relative;\r\n            width: 100%;\r\n            max-width: 400px; /* or 100% for full width */\r\n            border-radius: 10px;\r\n            overflow: hidden;\r\n        }\r\n\r\n            .video-wrapper iframe {\r\n                width: 100%;\r\n                height: 225px;\r\n                border-radius: 10px;\r\n            }\r\n\r\n        .video-overlay {\r\n            margin-top: 6px;\r\n        }\r\n\r\n        .yt-redirect {\r\n            text-decoration: none;\r\n            color: #c4302b;\r\n            font-size: 13px;\r\n        }\r\n\r\n            .yt-redirect i {\r\n                font-size: 12px; /* reduce icon size */\r\n                margin-left: 4px;\r\n            }\r\n\r\n\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n    <div class=\"container\">\r\n        <header class=\"header\">\r\n            <h1>Welcome To <br /><strong>Sitaram Jindal Foundation</strong></h1>\r\n            <p>Dedicated to the service of mankind!</p>\r\n        </header>\r\n\r\n        <section class=\"card\">\r\n            <div class=\"card-left\">\r\n                <img src=\"/Assets/Images/Logo/SJF-removebg-preview.png\" alt=\"SJF Logo\" class=\"logo\" />\r\n                <h2>Support your Academic Ambitions with our esteemed <br /><strong>Scholarship Program!</strong></h2>\r\n\r\n                \r\n                \r\n            <a href=